# WISMO Chat Assistant - Environment Configuration
# Copy this file to `.env` in the project root directory:
#   cp .env.example .env

# Model & Live LLM Toggle (Powered exclusively by GPT 6 Luna)
LLM_MODEL=gpt-6-luna
WISMO_LIVE_LLM=0

# API Key for GPT 6 Luna (leave blank to use the built-in deterministic simulator)
OPENAI_API_KEY=

# Security & Phone Normalization
PHONE_HMAC_SECRET=wismo-dev-hmac-secret-key
DEFAULT_PHONE_REGION=US

# Database (only needed for live PostgreSQL 16 runs)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/wismo
